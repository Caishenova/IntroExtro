# Quiet Growth Mobile App Backend - Environment Variables
# Copy this file to .env and set your API key:
#   cp .env.example .env

# Google Gemini API Key (Recommended)
# Get a key at: https://aistudio.google.com/
GEMINI_API_KEY=

# OR OpenAI API Key
# Get a key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Port for the local backend server (default 3000)
PORT=3000
